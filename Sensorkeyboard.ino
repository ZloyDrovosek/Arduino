// Указываем пин 13, чтобы светодиод можно было вставить 
// прямо в отверстия 13 и GND на плате без бредборда
const int ledPin = 13; 

void setup() {
  Serial.begin(9600);      // Открываем порт для связи с ПК
  pinMode(ledPin, OUTPUT); // Настраиваем пин 13 как выход
}

void loop() {
  // Пока в буфере есть необработанные символы от ПК (нажатия клавиш)
  while (Serial.available() > 0) {
    Serial.read(); // Считываем символ, чтобы очистить очередь
    
    // Одно очень быстрое моргание внешнего светодиода
    digitalWrite(ledPin, HIGH);  // Включаем светодиод
    delay(40);                   // Ждем 40 миллисекунд
    digitalWrite(ledPin, LOW);   // Выключаем светодиод
    delay(40);                   // Пауза 40 миллисекунд перед следующим символом
  }
}




